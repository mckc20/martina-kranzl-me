---
import Listing from "@/layouts/Listing.astro";
import { allEntries, entryUrl, entryTitle } from "@/utils/content";
import { formatGermanDate as formatDate } from "@/utils/formatDate";
const entries = await allEntries();
---

<Listing title="Archives" base="/archives/" current={1} total={1}>
  <div slot="heading" class="listing-heading">
    <h1>Archives</h1>
  </div>
  <ul class="archive-list">
    {
      entries.map(entry => (
        <li>
          <>
            <a href={entryUrl(entry)}>{entryTitle(entry)}</a>
            <time datetime={entry.data.pubDatetime.toISOString()}>
              {formatDate(entry.data.pubDatetime)}
            </time>
            <span>{entry.collection === "photos" ? "Photo" : "Blog"}</span>
          </>
        </li>
      ))
    }
  </ul>
</Listing>
<style>
  li {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }
  li a {
    flex: 1 1 45%;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
  }
  time,
  span {
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }
</style>
