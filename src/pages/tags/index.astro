---
import Listing from "@/layouts/Listing.astro";
import TagLinks from "@/components/TagLinks.astro";
import { allEntries } from "@/utils/content";
import { tagsFor } from "@/utils/content/tags";
const tags = tagsFor(await allEntries()).map(tag => tag.label);
---

<Listing title="Subjects" base="/tags/" current={1} total={1}
  ><TagLinks {tags} /></Listing
>
