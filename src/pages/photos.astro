---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PhotosGallery from "@/components/PhotosGallery.astro";
import { SITE } from "@/config";
---

<Layout
  title={`Photos | ${SITE.title}`}
  description="Fotografien von Martina Kranzl."
>
  <Header />
  <main
    id="main-content"
    class="w-full flex-1 px-7 py-10"
    data-backurl="/photos/"
  >
    <header class="mx-auto mb-8 text-center">
      <h1 class="text-2xl font-normal sm:text-3xl">Photos</h1>
    </header>
    <PhotosGallery />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    if (document.querySelector("main[data-backurl='/photos/']")) {
      sessionStorage.setItem("backUrl", "/photos/");
    }
  });
</script>
