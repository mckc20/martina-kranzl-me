---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PhotoGrid from "@/components/PhotoGrid.astro";
import BlogCard from "@/components/BlogCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TagLinks from "@/components/TagLinks.astro";
import { photos, blog, allEntries } from "@/utils/content";
import { tagsFor } from "@/utils/content/tags";
const recentPhotos = (await photos("publication")).slice(0, 4);
const recentBlog = (await blog()).slice(0, 3);
const subjects = tagsFor(await allEntries()).map(tag => tag.label);
---

<Layout>
  <Header />
  <main id="main-content" class="shell home">
    <div class="home-text app-prose">
      <!-- Edit your text here. Use <p> for paragraphs and <h1>–<h6> for headings. -->
      <h3>Hello and welcome to my web!</h4>
      <p>Hi, I'm Martina! I love reading, art and photography. I'm a high school student and I live in Vienna.</p>
    </div>
    <div class="home-sections">
      <section class="home-photos">
        <SectionHeading
          title="Recent Photos"
          href="/photos/"
          label="All photos ->"
        /><PhotoGrid photos={recentPhotos} compact square />
      </section>
      <section class="home-blog">
        <SectionHeading
          title="From my blog"
          href="/blog/"
          label="All posts ->"
        />{recentBlog.map(post => <BlogCard {post} />)}
      </section>
    </div>
    <section class="subjects">
      <p class="eyebrow">Explore by subject</p><TagLinks tags={subjects} />
    </section>
  </main>
  <Footer />
</Layout>
<style>
  .home-text {
    margin-bottom: 64px;
  }
  .home-text :global(> :first-child) {
    margin-top: 0;
  }
  .home-text :global(> :last-child) {
    margin-bottom: 0;
  }
  .home-sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 64px;
  }
  .subjects {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .home-photos :global(.photo-tile:nth-child(n + 4)) {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .home-text {
      margin-bottom: 48px;
    }
    .home-sections {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .subjects {
      margin-top: 48px;
    }
  }
</style>
