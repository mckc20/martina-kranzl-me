---
import { photos } from "@/utils/content";
import Listing from "@/layouts/Listing.astro";
import PhotoGrid from "@/components/PhotoGrid.astro";
export async function getStaticPaths() {
  const entries = await photos();
  return Array.from(
    { length: Math.max(0, Math.ceil(entries.length / 24) - 1) },
    (_, index) => ({
      params: { page: String(index + 2) },
      props: {
        entries: entries.slice((index + 1) * 24, (index + 2) * 24),
        current: index + 2,
        total: Math.ceil(entries.length / 24),
      },
    })
  );
}
const { entries, current, total } = Astro.props;
---

<Listing title="Photos" base="/photos/" {current} {total} photo>
  <PhotoGrid photos={entries} />
</Listing>
