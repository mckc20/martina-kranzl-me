---
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
interface Props {
  flushBottom?: boolean;
}
const { flushBottom = false } = Astro.props;
const links = [
  ["/", "Home"],
  ["/photos/", "Photos"],
  ["/blog/", "Blog"],
];
const active = (href: string) =>
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href.replace(/\/$/, ""));
---

<header
  class:list={["site-header", { "flush-bottom": flushBottom }]}
  data-pagefind-ignore
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <nav class="site-nav shell" aria-label="Primary navigation">
    <a href="/" class="wordmark" aria-label="martina kranzl home">
      <img
        src="/favicon-96x96.png"
        width="96"
        height="96"
        alt=""
        class="site-portrait"
      />
      <span class="wordmark-text">martina kranzl</span>
    </a>
    <ul class="primary-links">
      {
        links.map(([href, label]) => (
          <li>
            <a href={href} aria-current={active(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="nav-tools">
      <a href="/search/" aria-label="Search"
        ><IconSearch width="20" height="20" /></a
      >
      <button
        id="theme-btn"
        aria-label="Switch to dark mode"
        title="Change colour theme"
      >
        <IconSunHigh class="theme-sun" aria-hidden="true" />
        <IconMoon class="theme-moon" aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>
<style>
  .site-header {
    margin-bottom: 48px;
  }
  .site-header.flush-bottom {
    margin-bottom: 0;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 104px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 24px;
    white-space: nowrap;
  }
  .site-portrait {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .primary-links {
    display: flex;
    gap: 24px;
    margin-left: auto;
  }
  .primary-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .primary-links a[aria-current] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 8px;
  }
  .nav-tools {
    display: flex;
    gap: 8px;
  }
  .nav-tools a,
  .nav-tools button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    background: var(--background);
    padding: 12px;
    z-index: 100;
  }
  #theme-btn {
    position: relative;
  }
  #theme-btn svg {
    position: absolute;
    transition: transform 200ms ease;
  }
  .theme-sun {
    transform: scale(1) rotate(0);
  }
  .theme-moon {
    transform: scale(0) rotate(-90deg);
  }
  :global([data-theme="dark"]) .theme-sun {
    transform: scale(0) rotate(90deg);
  }
  :global([data-theme="dark"]) .theme-moon {
    transform: scale(1) rotate(0);
  }
  @media (prefers-reduced-motion: reduce) {
    #theme-btn svg {
      transition: none;
    }
  }
  .skip-link:focus {
    top: 8px;
  }
  @media (max-width: 767px) {
    .site-nav {
      gap: 8px;
      flex-wrap: wrap;
      padding-top: 16px;
      padding-bottom: 12px;
    }
    .wordmark {
      min-width: 44px;
      justify-content: center;
    }
    .wordmark-text {
      display: none;
    }
    .nav-tools {
      margin-left: auto;
    }
    .primary-links {
      order: 3;
      width: 100%;
      margin: 0;
      justify-content: space-between;
      gap: 12px;
    }
    .site-header {
      margin-bottom: 32px;
    }
  }
  @media (max-width: 359px) {
    .nav-tools {
      gap: 4px;
    }
    .primary-links {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 4px 16px;
    }
  }
</style>
