---
// Adapted from Astro AntfuStyle Theme's ImageViewer.astro (MIT).
// https://github.com/lin-stephanie/astro-antfustyle-theme/blob/main/src/components/widgets/ImageViewer.astro
// Copyright (c) 2024 Stephanie Lin. See licenses/astro-antfustyle-theme.txt.
import type Viewer from "viewerjs";
import "viewerjs/dist/viewer.css";

interface Props {
  selector: string;
  options?: Viewer.Options;
  asyncInsert?: boolean;
  tabFocus?: boolean;
}

const {
  selector,
  options,
  asyncInsert = false,
  tabFocus = false,
} = Astro.props;
---

<image-viewer
  data-selector={selector}
  data-options={JSON.stringify(options)}
  data-async-insert={asyncInsert ? "" : undefined}
  data-tab-focus={tabFocus ? "" : undefined}></image-viewer>

<script>
  import Viewer from "viewerjs";

  // Keep AntfuStyle's viewer settings local to this component.
  const defaults: Viewer.Options = {
    button: false,
    navbar: 2,
    toolbar: false,
    initialCoverage: 1,
    transition: false,
    zIndexInline: 300,
    filter: image =>
      !image.classList.contains("no-zoom") &&
      image.parentNode?.nodeName !== "A" &&
      image.parentNode?.parentNode?.nodeName !== "A",
  };

  class ImageViewer extends HTMLElement {
    #viewer: Viewer | null = null;
    #mutationObserver: MutationObserver | null = null;
    #lastViewedImage: HTMLImageElement | null = null;
    #controller: AbortController | null = null;
    #focusFrame = 0;
    #unlockScroll: (() => void) | null = null;

    connectedCallback() {
      if (this.#controller) return;
      this.#controller = new AbortController();
      const { signal } = this.#controller;
      const selector = this.dataset.selector || "img";
      const container =
        this.parentElement?.querySelector<HTMLElement>(selector);
      if (!container) return;

      let userOptions: Viewer.Options = {};
      if (this.dataset.options) userOptions = JSON.parse(this.dataset.options);

      const initOrUpdateViewer = () => {
        if (this.#viewer) {
          this.#viewer.update();
          return;
        }

        if (container.querySelector("img")) {
          this.#viewer = new Viewer(container, {
            ...defaults,
            container: this,
            // Use the same visible description as the upstream gallery.
            title: [
              1,
              image =>
                Array.from(
                  container.querySelectorAll<HTMLImageElement>("img")
                ).find(
                  original =>
                    new URL(
                      original.dataset.origin ?? original.src,
                      document.baseURI
                    ).href === image.src
                )?.dataset.caption ?? "",
            ],
            ...userOptions,
            view: ({ detail }) => {
              this.#lastViewedImage = detail.originalImage;
            },
            viewed: ({ detail }) => {
              // Viewer.js writes its plain-text title during the same event.
              // Add the native link after those listeners finish.
              queueMicrotask(() => {
                if (this.#lastViewedImage !== detail.originalImage) return;
                const title = this.querySelector<HTMLElement>(".viewer-title");
                const { postUrl, caption } = detail.originalImage.dataset;
                if (!title || !postUrl || !caption) return;
                const link = document.createElement("a");
                link.href = postUrl;
                link.textContent = caption;
                title.replaceChildren(link);
              });
            },
            hidden: () => {
              if (!this.hasAttribute("data-tab-focus")) return;
              const target =
                this.#lastViewedImage?.closest<HTMLElement>(".photo-figure");
              if (target) {
                this.#focusFrame = requestAnimationFrame(() => {
                  if (target.isConnected) target.focus({ preventScroll: true });
                });
              }
              this.#lastViewedImage = null;
            },
          });

          // AntfuStyle's scroll-lock workaround for Viewer.js issue #197.
          // Preserve inline styles so closing or navigating away restores them.
          const viewer = this.#viewer as Viewer & {
            open(): void;
            close(): void;
          };
          viewer.open = () => {
            if (this.#unlockScroll) return;
            const body = document.body;
            const { overflow, paddingRight } = body.style;
            const scrollbarWidth = window.innerWidth - body.clientWidth;
            if (scrollbarWidth > 0)
              body.style.paddingRight = `${scrollbarWidth}px`;
            body.style.overflow = "hidden";
            this.#unlockScroll = () => {
              body.style.overflow = overflow;
              body.style.paddingRight = paddingRight;
              this.#unlockScroll = null;
            };
          };
          viewer.close = () => this.#unlockScroll?.();
        }
      };

      initOrUpdateViewer();

      if (this.hasAttribute("data-async-insert")) {
        this.#mutationObserver = new MutationObserver(initOrUpdateViewer);
        this.#mutationObserver.observe(container, { childList: true });
      }
      document.addEventListener("astro:before-swap", () => this.cleanup(), {
        once: true,
        signal,
      });
    }

    disconnectedCallback() {
      this.cleanup();
    }

    private cleanup() {
      this.#controller?.abort();
      this.#controller = null;
      this.#mutationObserver?.disconnect();
      this.#mutationObserver = null;
      this.#viewer?.destroy();
      this.#viewer = null;
      this.#unlockScroll?.();
      cancelAnimationFrame(this.#focusFrame);
      this.#lastViewedImage = null;
    }
  }

  if (!customElements.get("image-viewer"))
    customElements.define("image-viewer", ImageViewer);
</script>

<style is:global>
  image-viewer .viewer-title {
    max-width: min(90%, 48rem);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    white-space: normal;
    overflow-wrap: anywhere;
    opacity: 1;
  }
  image-viewer .viewer-title:empty {
    display: none;
  }
  image-viewer .viewer-title a {
    color: inherit;
    text-decoration: underline dashed 1px;
    text-underline-offset: 4px;
  }
  image-viewer .viewer-title a:focus-visible {
    outline: 2px dashed white;
    outline-offset: 4px;
  }
  image-viewer img {
    max-width: none;
  }
</style>
