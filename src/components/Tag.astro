---
import IconHash from "@/assets/icons/IconHash.svg";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  appearance?: "default" | "quiet";
}

const { tag, tagName, size = "sm", appearance = "default" } = Astro.props;
const quiet = appearance === "quiet";
---

<li
  class:list={[
    "group inline-block group-hover:cursor-pointer",
    !quiet &&
      (size === "sm"
        ? "my-1 underline-offset-4"
        : "mx-1 my-3 underline-offset-8"),
  ]}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      quiet
        ? "inline-flex text-sm text-text-subtle hover:text-foreground"
        : "relative inline-flex items-center gap-1 pe-2 text-xl underline decoration-dashed group-hover:-top-0.5 group-hover:text-accent focus-visible:p-1 focus-visible:no-underline",
      { "text-base": !quiet && size === "sm" },
    ]}
  >
    {
      !quiet && (
        <IconHash
          class:list={[
            "inline-block shrink-0 opacity-80",
            { "size-4": size === "sm" },
            { "size-6": size === "lg" },
          ]}
        />
      )
    }
    <span>{tagName}</span>
  </a>
</li>
