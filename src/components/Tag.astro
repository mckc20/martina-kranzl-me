---
import IconHash from "@/assets/icons/IconHash.svg";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  appearance?: "default" | "quiet";
  href?: string;
  current?: boolean;
  showHash?: boolean;
}

const {
  tag,
  tagName,
  size = "sm",
  appearance = "default",
  href = `/tags/${tag}/`,
  current = false,
  showHash = true,
} = Astro.props;
const quiet = appearance === "quiet";
---

<li
  class:list={[
    "group inline-block group-hover:cursor-pointer",
    !quiet && (size === "sm" ? "my-1" : "mx-1 my-3"),
  ]}
>
  <a
    href={href}
    aria-current={current ? "page" : undefined}
    class:list={[
      quiet
        ? "inline-flex text-sm text-text-subtle hover:text-foreground"
        : "inline-flex items-center gap-1 pe-2 text-xl decoration-dashed decoration-1 underline-offset-4 group-hover:text-accent hover:underline focus-visible:underline",
      { "text-base": !quiet && size === "sm" },
      { "font-medium text-accent": current },
    ]}
  >
    {
      !quiet && showHash && (
        <IconHash
          class:list={[
            "inline-block shrink-0 opacity-80",
            { "size-4": size === "sm" },
            { "size-6": size === "lg" },
          ]}
        />
      )
    }
    <span>{tagName}</span>
  </a>
</li>
