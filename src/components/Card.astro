---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id, filePath } = Astro.props;
const { title, description, pubDatetime, modDatetime, timezone } = data;
const postUrl = getPath(id, filePath);
const Heading = variant;
---

<li class="mb-10 last:mb-0 sm:mb-12">
  <article>
    <a
      href={postUrl}
      class="post-card group grid items-start gap-3 text-foreground sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-8"
      aria-labelledby={slugifyStr(title)}
    >
      <div class="min-w-0">
        <Heading
          id={slugifyStr(title)}
          style={{ viewTransitionName: slugifyStr(title) }}
          class="row-title"
        >
          {title}
        </Heading>
        <Datetime
          {pubDatetime}
          {modDatetime}
          {timezone}
          class="mt-1 flex-wrap"
        />
        {
          description && (
            <p class="mt-3 text-lg leading-relaxed text-foreground/85">
              {description}
            </p>
          )
        }
      </div>
      <span
        aria-hidden="true"
        class="hidden text-base whitespace-nowrap text-text-subtle opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none sm:block"
      >
        Read Post →
      </span>
    </a>
  </article>
</li>
