---
import type { CollectionEntry } from "astro:content";
import { entryUrl } from "@/utils/content";
import { formatGermanDate as formatDate } from "@/utils/formatDate";
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<article class="blog-card">
  <a href={entryUrl(post)}>
    <div class="card-content">
      <time datetime={post.data.pubDatetime.toISOString()}
        >{formatDate(post.data.pubDatetime)}</time
      >
      <div class="title-row">
        <h3>{post.data.title}</h3>
        <span class="read" aria-hidden="true">Read post -&gt;</span>
      </div>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  </a>
</article>
<style>
  .blog-card {
    border-bottom: 1px solid var(--border);
    padding-bottom: 32px;
    margin-bottom: 32px;
  }
  .blog-card a {
    display: flex;
    gap: 24px;
    justify-content: space-between;
  }
  .card-content {
    flex: 1;
    min-width: 0;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .blog-card h3 {
    font-size: 1.375rem;
    line-height: 1.25;
    margin-block: 12px;
    min-width: 0;
  }
  .blog-card a:hover h3,
  .blog-card a:focus-visible h3 {
    text-decoration-line: underline;
    text-decoration-style: dashed;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .blog-card time {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .blog-card p {
    margin-top: 16px;
    font-size: var(--text-base);
  }
  .read {
    flex-shrink: 0;
    white-space: nowrap;
    line-height: 1.25;
    opacity: 0;
    color: var(--accent);
    font-size: var(--text-sm);
  }
  .blog-card a:hover .read,
  .blog-card a:focus-visible .read {
    opacity: 1;
  }
  @media (max-width: 359px) {
    .read {
      display: none;
    }
  }
</style>
