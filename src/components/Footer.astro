---
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const currentYear = new Date().getFullYear();
export interface Props {
  noMarginTop?: boolean;
}
---

<footer class="shell w-full pt-12 pb-10 sm:pt-24 sm:pb-14">
  <nav
    class="mb-4 flex flex-wrap gap-x-6 gap-y-1 text-sm"
    aria-label="Footer navigation"
  >
    <a href="/about/" class="decoration-1 underline-offset-2 hover:underline"
      >About</a
    >
    <a href="/rss.xml" class="decoration-1 underline-offset-2 hover:underline"
      >RSS</a
    >
    <a href="/archives/">Archives</a>
    <a
      href="https://github.com/satnaing/astro-paper"
      class="decoration-1 underline-offset-2 hover:underline"
      >Built with AstroPaper</a
    >
  </nav>
  <div
    class="flex flex-col gap-4 border-t border-solid border-foreground pt-6 text-sm sm:flex-row-reverse sm:items-center sm:justify-between"
  >
    {
      SOCIALS.length > 0 && (
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          {SOCIALS.map(social => (
            <a
              href={social.href}
              title={social.linkTitle}
              class="decoration-1 underline-offset-2 hover:underline"
            >
              {social.name}
            </a>
          ))}
        </div>
      )
    }
    <p>
      © {currentYear}
      <a href="/" class="decoration-1 underline-offset-2 hover:underline"
        >{SITE.title}</a
      >
    </p>
  </div>
</footer>
