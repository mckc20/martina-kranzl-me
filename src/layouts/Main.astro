---
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = (StringTitleProp | ArrayTitleProp) & {
  showBreadcrumb?: boolean;
  showDescription?: boolean;
};

const { props } = Astro;
const titleClass = props.showDescription
  ? "text-2xl font-normal sm:text-3xl"
  : "page-title";

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

{props.showBreadcrumb && <Breadcrumb />}
<main
  data-backUrl={backUrl}
  id="main-content"
  class="mx-auto w-full max-w-app flex-1 px-4"
>
  {
    "titleTransition" in props ? (
      <h1 class={titleClass}>
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class={titleClass}>{props.pageTitle}</h1>
    )
  }
  {
    props.pageDesc && (
      <p class={props.showDescription ? "mt-2 mb-6 italic" : "sr-only"}>
        {props.pageDesc}
      </p>
    )
  }
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
